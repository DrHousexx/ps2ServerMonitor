PORT=8080
BOINC_CONTAINER=boinc-lab

LCD_ENABLED=true
LCD_SERIAL_PORT=/dev/ttyACM0
LCD_BAUD_RATE=9600
LCD_PAGE_DURATION_MS=5000
LCD_LONG_PAGE_DURATION_MS=10000

ALERT_DISK_PCT=90
ALERT_CPU_PCT=95
ALERT_CPU_SUSTAINED_MS=300000

# Path donde se monta "/" del host dentro del contenedor (ver docker-compose.yml).
# Necesario para que el % de disco mostrado sea el del server real.
HOST_ROOT_PATH=/host
